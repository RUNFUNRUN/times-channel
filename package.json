{
  "name": "times-channel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "check": "biome check .",
    "check:fix": "biome check --write --unsafe .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --infer-origin-from-routes=false",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "bun test tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/vercel": "^1.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@opennextjs/cloudflare": "^1.20.18",
    "@tanstack/react-query": "^5.108.4",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "entities": "^9.0.0",
    "hono": "^4.13.21",
    "lucide-react": "^1.78.0",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bun": "^1.4.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.166.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
