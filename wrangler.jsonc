{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "times-channel",
  "workers_dev": false,
  "routes": [{ "pattern": "times.runfunrun.xyz", "custom_domain": true }],
  "preview_urls": false,
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "BETTER_AUTH_URL": "https://times.runfunrun.xyz"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "times-channel",
      "database_id": "b219abbe-2d08-4375-9405-9c59d29fb885",
      // Preserve the existing local development database when targeting production.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "times-channel"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "WorkspaceRealtime" }]
  },
  "migrations": [
    { "tag": "realtime-v1", "new_sqlite_classes": ["WorkspaceRealtime"] }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "times-channel-uploads"
    }
  ]
}
